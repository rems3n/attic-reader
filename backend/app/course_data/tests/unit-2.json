        {"type": "true-false-grc", "prompt": "ἡ Θρᾷττα ἐλευθέρα ἐστίν.", "answer": "false", "skills": ["read.comprehension"], "explain": "δούλη ἐστίν."},
        {"type": "true-false-grc", "prompt": "ἡ Θρᾷττα τὸ ὕδωρ ἐκ τῆς κρήνης φέρει.", "answer": "true", "skills": ["read.comprehension"], "explain": "τὴν ὑδρίαν λαμβάνει καὶ εἰς τὴν κρήνην σπεύδει· «ἐγὼ μὲν τὸ ὕδωρ φέρω …»"},
