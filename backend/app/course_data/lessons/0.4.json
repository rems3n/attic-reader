        {"text": "τί ἐστιν; δένδρον ἐστίν. τί ἐστιν; ἄνθος ἐστίν. τὸ ἄνθος καλόν ἐστιν.", "glosses": [{"word": "δένδρον", "kind": "pic", "value": "dendron"}, {"word": "ἄνθος", "kind": "pic", "value": "anthos"}, {"word": "τὸ", "kind": "=", "value": "ὁ | ἡ | τό"}, {"word": "καλόν", "kind": "pic", "value": "kalos"}]},
