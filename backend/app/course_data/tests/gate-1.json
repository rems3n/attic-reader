      "passage_title": "Δευκαλίων καὶ Πύρρα (adapted from Apollodorus, Library 1.7.2)",
      "passage": "ὁ Δευκαλίων υἱὸς ἦν τοῦ Προμηθέως· γυναῖκα δὲ εἶχε τὴν Πύρραν. ἐν ἐκείνῳ τῷ χρόνῳ οἱ ἄνθρωποι κακοὶ ἦσαν, καὶ ὁ Ζεὺς πολὺ ὕδωρ ἐπὶ τὴν γῆν πέμπειν ἐβούλετο. ὁ δὲ Προμηθεύς, ὃς πάντα ἐγίγνωσκε, τῷ Δευκαλίωνι εἶπε· «ποίησον μέγα πλοῖον καὶ βαῖνε εἰς αὐτὸ μετὰ τῆς γυναικός.» ὁ Δευκαλίων οὕτως ἐποίησε. ὁ δὲ Ζεὺς πολὺ ὕδωρ ἐκ τοῦ οὐρανοῦ ἔπεμψε, καὶ πᾶσα ἡ γῆ θάλαττα ἐγένετο· οἱ δὲ ἄνθρωποι πάντες ἀπέθανον. ὁ δὲ Δευκαλίων ἐννέα ἡμέρας καὶ ἐννέα νύκτας ἐν τῷ πλοίῳ ἔπλει· τῇ δὲ δεκάτῃ ἡμέρᾳ πρὸς ὄρος μέγα, τὸν Παρνασσόν, ἦλθε. ἐκεῖ ἐκ τοῦ πλοίου ἐξέβη καὶ τῷ Διὶ ἔθυσε. ὁ δὲ Ζεὺς τὸν Ἑρμῆν πρὸς αὐτὸν ἔπεμψε· «τί βούλει;» «ἀνθρώπους βούλομαι», εἶπεν ὁ Δευκαλίων. ὁ οὖν Ζεὺς ἐκέλευσεν αὐτὸν λίθους ὑπὲρ τῆς κεφαλῆς βάλλειν. καὶ οἱ μὲν λίθοι, οὓς ὁ Δευκαλίων ἔβαλλεν, ἄνδρες ἐγένοντο, οἱ δὲ τῆς Πύρρας γυναῖκες. οὕτως οἱ ἄνθρωποι πάλιν ἐγένοντο.",
      "items": [
        {"type": "answer-grc", "prompt": "τίς ἦν ὁ πατὴρ τοῦ Δευκαλίωνος;", "options": [{"id": "a", "text": "ὁ Προμηθεύς."}, {"id": "b", "text": "ὁ Ζεύς."}, {"id": "c", "text": "ὁ Ἑρμῆς."}], "answer": "a", "skills": ["read.comprehension", "read.myth"], "explain": "ὁ Δευκαλίων υἱὸς ἦν τοῦ Προμηθέως."},
        {"type": "answer-grc", "prompt": "τί ἐκέλευσεν ὁ Προμηθεὺς τὸν Δευκαλίωνα ποιεῖν;", "options": [{"id": "a", "text": "μέγα πλοῖον."}, {"id": "b", "text": "μεγάλην οἰκίαν."}, {"id": "c", "text": "κύλικας."}], "answer": "a", "skills": ["read.comprehension", "read.myth"], "explain": "«ποίησον μέγα πλοῖον.»"},
        {"type": "answer-grc", "prompt": "πόσας ἡμέρας ἔπλει ὁ Δευκαλίων;", "options": [{"id": "a", "text": "ἐννέα."}, {"id": "b", "text": "δέκα."}, {"id": "c", "text": "τρεῖς."}], "answer": "a", "skills": ["read.comprehension", "syntax.acc.extent"], "explain": "ἐννέα ἡμέρας καὶ ἐννέα νύκτας ἔπλει· τῇ δεκάτῃ ἡμέρᾳ ἦλθε."},
        {"type": "answer-grc", "prompt": "ποῖ ἦλθε τῇ δεκάτῃ ἡμέρᾳ;", "options": [{"id": "a", "text": "πρὸς τὸν Παρνασσόν."}, {"id": "b", "text": "εἰς τὰς Ἀθήνας."}, {"id": "c", "text": "εἰς τὴν Μίλητον."}], "answer": "a", "skills": ["read.comprehension", "adv.interrog-indef"], "explain": "πρὸς ὄρος μέγα, τὸν Παρνασσόν, ἦλθε."},
        {"type": "answer-grc", "prompt": "τίνες ἐγένοντο οἱ λίθοι τῆς Πύρρας;", "options": [{"id": "a", "text": "γυναῖκες."}, {"id": "b", "text": "ἄνδρες."}, {"id": "c", "text": "πλοῖα."}], "answer": "a", "skills": ["read.comprehension", "read.myth"], "explain": "οἱ δὲ τῆς Πύρρας γυναῖκες (ἐγένοντο)."},
        {"type": "parse", "prompt": "Parse ἔπεμψε (from the passage).", "form": "ἔπεμψε", "groups": [{"id": "tense", "label": "Tense", "options": [{"id": "pres", "label": "present"}, {"id": "impf", "label": "imperfect"}, {"id": "aor", "label": "aorist"}]}, {"id": "person", "label": "Person and number", "options": [{"id": "1sg", "label": "1st singular"}, {"id": "3sg", "label": "3rd singular"}, {"id": "3pl", "label": "3rd plural"}]}], "answer": {"tense": "aor", "person": "3sg"}, "skills": ["verb.aor.act.ind.3sg", "verb.aor1.sigma"], "explain": "ἔ-πεμψ-ε: aorist 3rd singular of πέμπω, 'he sent'.", "audio": "ἔπεμψε"},
        {"type": "parse", "prompt": "Parse ἐκείνῳ (from ἐν ἐκείνῳ τῷ χρόνῳ).", "form": "ἐκείνῳ", "groups": [{"id": "case", "label": "Case", "options": [{"id": "nom", "label": "nominative"}, {"id": "gen", "label": "genitive"}, {"id": "dat", "label": "dative"}, {"id": "acc", "label": "accusative"}]}, {"id": "gender", "label": "Gender", "options": [{"id": "m", "label": "masculine"}, {"id": "f", "label": "feminine"}, {"id": "n", "label": "neuter"}]}], "answer": {"case": "dat", "gender": "m"}, "skills": ["pron.demonstrative", "syntax.dat.time"], "explain": "ἐκείνῳ agrees with τῷ χρόνῳ: dative masculine, 'at that time'.", "audio": "ἐκείνῳ"},
        {"type": "parse", "prompt": "Parse ἐγένοντο.", "form": "ἐγένοντο", "groups": [{"id": "tense", "label": "Tense", "options": [{"id": "pres", "label": "present"}, {"id": "impf", "label": "imperfect"}, {"id": "aor", "label": "aorist"}]}, {"id": "person", "label": "Person and number", "options": [{"id": "1sg", "label": "1st singular"}, {"id": "3sg", "label": "3rd singular"}, {"id": "3pl", "label": "3rd plural"}]}], "answer": {"tense": "aor", "person": "3pl"}, "skills": ["verb.aor2.stem", "verb.deponent"], "explain": "ἐ-γεν-οντο: second aorist of γίγνομαι, 3rd plural, 'they became'.", "audio": "ἐγένοντο"},
