      "image": "theos",
      "sentences": [
        {"text": "τίς ἐστιν; θεός ἐστιν. ὁ Ζεὺς θεός ἐστιν.", "glosses": [{"word": "τίς", "kind": "en", "value": "who?"}, {"word": "ἐστιν", "kind": "en", "value": "is"}, {"word": "θεός", "kind": "pic", "value": "theos"}]},
        {"text": "τίς ἐστιν; θεά ἐστιν. ἡ Ἀθηνᾶ θεά ἐστιν.", "glosses": [{"word": "θεά", "kind": "pic", "value": "thea"}, {"word": "ἡ", "kind": "|", "value": "ὁ | ἡ"}]},
        {"text": "ὁ Ζεὺς θεός ἐστιν, οὐ θεά. ἡ Ἀθηνᾶ θεά ἐστιν, οὐ θεός.", "glosses": [{"word": "οὐ", "kind": "=", "value": "✗"}]},
        {"text": "ὁ Ζεὺς καὶ ἡ Ἀθηνᾶ θεοί εἰσιν.", "glosses": [{"word": "καὶ", "kind": "=", "value": "Α καὶ Β"}, {"word": "θεοί", "kind": "|", "value": "θεός | θεοί"}, {"word": "εἰσιν", "kind": "|", "value": "ἐστίν | εἰσίν"}]}
      ]
    },
    {
      "image": "hippos",
      "sentences": [
        {"text": "τί ἐστιν; ἵππος ἐστίν. ὁ ἵππος οὐκ ἄνθρωπός ἐστιν.", "glosses": [{"word": "τί", "kind": "en", "value": "what?"}, {"word": "ἵππος", "kind": "pic", "value": "hippos"}, {"word": "ἄνθρωπός", "kind": "pic", "value": "anthropos"}, {"word": "οὐκ", "kind": "=", "value": "οὐ + vowel → οὐκ"}]},
        {"text": "τί ἐστιν; κύων ἐστίν. ὁ κύων οὐχ ἵππος ἐστίν.", "glosses": [{"word": "κύων", "kind": "pic", "value": "kyon"}, {"word": "οὐχ", "kind": "=", "value": "οὐ + ἁ ἑ ἡ ἱ ὁ ὑ → οὐχ"}]},
        {"text": "ὁ ἀνήρ ἄνθρωπός ἐστιν. ἡ γυνὴ ἄνθρωπός ἐστιν. ὁ παῖς ἄνθρωπός ἐστιν.", "glosses": [{"word": "ἀνήρ", "kind": "pic", "value": "aner"}, {"word": "γυνὴ", "kind": "pic", "value": "gyne"}, {"word": "παῖς", "kind": "pic", "value": "pais"}]},
        {"text": "τί ἐστιν; οἶκός ἐστιν. τί ἐστιν; ἀγορά ἐστιν. τί ἐστιν; πόλις ἐστίν.", "glosses": [{"word": "οἶκός", "kind": "pic", "value": "oikos"}, {"word": "ἀγορά", "kind": "pic", "value": "agora"}, {"word": "πόλις", "kind": "pic", "value": "polis"}]},
        {"text": "αἱ Ἀθῆναι πόλις εἰσίν. ἡ ἀγορὰ ἐν τῇ πόλει ἐστίν.", "glosses": [{"word": "αἱ", "kind": "=", "value": "ἡ | αἱ (plural)"}, {"word": "ἐν", "kind": "en", "value": "in"}, {"word": "πόλει", "kind": "=", "value": "πόλις → ἐν τῇ πόλει"}]}
      ]
    },
    {
      "image": "helios",
      "sentences": [
        {"text": "ὁ ἥλιος ἐν τῷ οὐρανῷ ἐστιν. καὶ ἡ σελήνη ἐν τῷ οὐρανῷ ἐστιν.", "glosses": [{"word": "ἥλιος", "kind": "pic", "value": "helios"}, {"word": "οὐρανῷ", "kind": "pic", "value": "ouranos"}, {"word": "σελήνη", "kind": "pic", "value": "selene"}]},
