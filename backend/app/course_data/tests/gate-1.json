        {"type": "translate-en", "prompt": "Translate: ὁ Δευκαλίων ἐννέα ἡμέρας καὶ ἐννέα νύκτας ἐν τῷ πλοίῳ ἔπλει.", "model": "Deucalion sailed in the boat for nine days and nine nights.", "skills": ["read.comprehension", "syntax.acc.extent"], "explain": "Accusative of extent: for nine days and nine nights; ἔπλει imperfect, 'kept sailing'."},
        {"type": "translate-en", "prompt": "Translate: οἱ λίθοι, οὓς ὁ Δευκαλίων ἔβαλλεν, ἄνδρες ἐγένοντο.", "model": "The stones which Deucalion was throwing became men.", "skills": ["read.comprehension", "syntax.relative-clause"], "explain": "οὕς: accusative, the object of ἔβαλλεν inside its clause; ἄνδρες is the predicate of ἐγένοντο."}
      ]
