# Backend
TESSERACT_COMMAND=tesseract
# OCR photo preprocessing: opencv (grayscale, illumination flattening, deskew),
# nodeskew, or basic (Pillow only).
OCR_PREPROCESS=opencv
TESSERACT_PSM=6
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Primary neural experiment: Kokoro with our Classical Attic phonemes
ENABLE_KOKORO=true
KOKORO_REPO_ID=hexgrad/Kokoro-82M
KOKORO_VOICE=im_nicola
KOKORO_LANG_CODE=i
# KOKORO_DEVICE=cpu
# Base narration pace. The API's `speed` (0.5–1.5) multiplies this.
KOKORO_SPEED=0.92
# One Kokoro chunk per sentence; sentences longer than this are split at clauses.
KOKORO_CHUNK_CHARS=450
KOKORO_PAUSE_MS=140

# Comparison neural voice: Meta MMS dedicated Ancient Greek (grc)
ENABLE_MMS=false
MMS_MODEL_ID=facebook/mms-tts-grc
# Optional: point to a downloaded local Hugging Face model directory.
# MMS_MODEL_PATH=/absolute/path/to/facebook-mms-tts-grc
MMS_DEVICE=cpu
MMS_LOCAL_FILES_ONLY=false
MMS_CHUNK_CHARS=180
MMS_PAUSE_MS=180
MMS_SEED=7

# Secondary experiment: Piper with our custom Classical Attic phonemes
PIPER_COMMAND=python -m piper
# PIPER_MODEL=/absolute/path/to/voice.onnx

# Robotic diagnostic only. Leave false for normal learner playback.
ALLOW_ESPEAK_FALLBACK=false
ESPEAK_COMMAND=espeak

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
